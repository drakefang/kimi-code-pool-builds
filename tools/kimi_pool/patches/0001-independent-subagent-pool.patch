@@ -0,0 +1,181 @@
+import { describe, expect, it } from 'vitest';
+import { produce } from 'immer';
+import { AgentProfileService } from '#/agent/profile/profileService';
+import { ProfileBind, ConfigUpdate, profileKey, type ProfileModelState } from '#/agent/profile/profileOps';
+import type { SubagentModelBinding } from '#/agent/profile/profile';
+import { SECONDARY_MODEL_SECTION, SecondaryModelConfigSchema, assertValidSubagentModelConfig, resolveSubagentBinding } from '#/session/subagent/configSection';
+import type { IModelCatalog, Model } from '#/llm-adapter/model/catalog';
+import type { FoldContext } from '#/state/state';
+import { StubConfigService } from '../../stubs';
+import { IAgentLifecycleService } from '#/session/agentLifecycle/agentLifecycle';
+import { IAgentProfileService } from '#/agent/profile/profile';
+import { IAgentLoopService } from '#/agent/loop/loop';
+import { Event } from '#/_base/event';
+import { IAppendLogStore } from '#/persistence/interface/appendLogStore';
+import { ISessionSubagentService } from '#/session/subagent/subagent';
+import { IConfigService, ConfigTarget } from '#/app/config/config';
+import { testAgent, configServices, llmGenerateServices, createScriptedGenerate, appService, sessionServices } from '../../harness';
+import { SyncDescriptor } from '#/_base/di/descriptors';
+import { IHostEnvironment } from '#/os/interface/hostEnvironment';
+import { IHostFileSystem } from '#/os/interface/hostFileSystem';
+import { IHostProcessService } from '#/os/interface/hostProcess';
+import { IHostTerminalService } from '#/os/interface/terminal';
+import { LocalRuntime } from '#/runtime/localRuntime';
+import type { Runtime, RuntimeBinding, RuntimeCapability, RuntimeLease } from '#/runtime/runtime';
+import { IRuntimeResolver } from '#/workspace/workspaceInstance/workspaceInstanceManager';
+
+const binding: SubagentModelBinding = { source: 'pool_entry', choice: 'review', model: 'canonical', effort: 'low' };
+let model = { id: 'canonical', capabilities: { thinking: true }, supportEfforts: ['low', 'high'], providerType: 'kimi' } as unknown as Model;
+const catalog = { get: (id: string) => { if (id !== 'canonical') throw new Error('unknown canonical'); return model; } } as IModelCatalog;
+const section = { defaultModel: 'review', defaultEffort: 'high', models: { review: { model: 'canonical', effort: 'low', description: 'Review code' } } };
+
+function consumer(state: ProfileModelState): AgentProfileService {
+  return Object.assign(Object.create(AgentProfileService.prototype), {
+    states: { get: () => state }, modelCatalog: catalog,
+    config: new StubConfigService({ thinking: { enabled: false, forcedEffort: 'high' } }),
+    sessionContext: { sessionId: 'test' },
+  });
+}
+
+describe('pool entry binding', () => {
+  it('resolves choice separately and overrides secondary default effort', () => {
+    const config = new StubConfigService({ [SECONDARY_MODEL_SECTION]: section });
+    assertValidSubagentModelConfig(config, catalog);
+    expect(resolveSubagentBinding(config, { modelAlias: 'caller', thinkingLevel: 'high' }, 'review')).toEqual({ model: 'canonical', thinking: 'low', modelSource: 'secondary_pool', poolChoice: 'review' });
+    expect(resolveSubagentBinding(config, { modelAlias: 'caller', thinkingLevel: 'high' }, 'primary')).toMatchObject({ model: 'caller', thinking: 'high' });
+  });
+
+  it.each(['off', 'on', 'unknown'])('rejects non-concrete or unsupported effort %s', (effort) => {
+    const config = new StubConfigService({ [SECONDARY_MODEL_SECTION]: { ...section, models: { review: { ...section.models.review, effort } } } });
+    expect(() => assertValidSubagentModelConfig(config, catalog)).toThrow();
+  });
+
+  it('rejects unknown object keys, missing descriptions and reserved primary', () => {
+    expect(SecondaryModelConfigSchema.safeParse({ ...section, models: { review: { ...section.models.review, extra: true } } }).success).toBe(false);
+    expect(SecondaryModelConfigSchema.safeParse({ ...section, models: { review: { model: 'canonical', effort: 'low' } } }).success).toBe(false);
+    expect(() => assertValidSubagentModelConfig(new StubConfigService({ [SECONDARY_MODEL_SECTION]: { defaultModel: 'primary', models: { primary: section.models.review } } }), catalog)).toThrow();
+  });
+
+  it('rejects absent canonical models and unknown support lists', () => {
+    expect(() => assertValidSubagentModelConfig(new StubConfigService({ [SECONDARY_MODEL_SECTION]: { ...section, models: { review: { ...section.models.review, model: 'missing' } } } }), catalog)).toThrow();
+    expect(() => assertValidSubagentModelConfig(new StubConfigService({ [SECONDARY_MODEL_SECTION]: section }), { get: () => ({ ...model, supportEfforts: undefined }) } as unknown as IModelCatalog)).toThrow();
+  });
+
+  it('preserves legacy string entries and rejects legacy metadata synthesis with objects', () => {
+    assertValidSubagentModelConfig(new StubConfigService({ [SECONDARY_MODEL_SECTION]: { defaultModel: 'canonical', models: { canonical: 'Legacy description' } } }), catalog);
+    expect(() => assertValidSubagentModelConfig(new StubConfigService({ [SECONDARY_MODEL_SECTION]: { ...section, model: 'canonical' } }), catalog)).toThrow();
+  });
+
+  it('replays durable binding and bypasses global thinking overrides at both request consumers', () => {
+    const payload = ProfileBind.schema.parse({ agentId: 'child', modelAlias: 'canonical', thinkingEffort: 'low', systemPrompt: '', disallowedTools: [], subagentBinding: binding });
+    const event = new ProfileBind(JSON.parse(JSON.stringify(payload)));
+    const fold = profileKey.replayable.folds.get(ProfileBind)!;
+    const state = produce(profileKey.initial(), (draft) => { const next = fold(draft, event, {} as FoldContext); if (next !== undefined) Object.assign(draft, next); });
+    expect(state.subagentBinding).toEqual(binding);
+    const service = consumer(state);
+    expect(service.resolveModelContext().thinkingLevel).toBe('low');
+    expect(service.resolveRequestParams().thinkingEffort).toBe('low');
+    const update = profileKey.replayable.folds.get(ConfigUpdate)!;
+    expect(() => produce(state, (draft) => { update(draft, new ConfigUpdate({ agentId: 'child', thinkingEffort: 'high' }), {} as FoldContext); })).toThrow('immutable');
+    const previous = model;
+    model = { ...model, supportEfforts: ['high'] };
+    try { expect(() => service.resolveModelContext()).toThrow(); } finally { model = previous; }
+  });
+});
+
+it('captures actual concurrent child requests for five tiers and restored binding', async () => {
+  const generator = createScriptedGenerate();
+  const requests: Array<{model: string; effort?: string}> = [];
+  const choiceEntries = Object.fromEntries(['low', 'high', 'max', 'max', 'max'].map((effort, i) => [`t${i + 1}`, { model: i < 3 ? 'flash' : `kimi${i}`, effort, description: `T${i + 1}` }]));
+  const config = {
+    providers: { synthetic: { type: 'openai_responses' as const, apiKey: 'synthetic', baseUrl: 'https://example.test/v1' } },
+    models: Object.fromEntries(['flash', 'kimi3', 'kimi4'].map(id => [id, { provider: 'synthetic', model: id, maxContextSize: 8192, capabilities: ['thinking', 'tool_use', 'always_thinking'], supportEfforts: ['low', 'high', 'max'], defaultEffort: 'max' }])),
+    defaultModel: 'flash', thinking: { enabled: false, forcedEffort: 'high' },
+    secondaryModel: { defaultModel: 't2', defaultEffort: 'high', models: choiceEntries },
+  };
+  const ctx = testAgent(appService(IAppendLogStore, new PoolTestAppendStore()),
+    sessionServices(reg => reg.defineDescriptor(IRuntimeResolver, new SyncDescriptor(PoolTestRuntimeResolver))),
+    configServices(() => config), llmGenerateServices({
+    generate: async (request, content, control) => {
+      requests.push({ model: request.model.model, effort: request.thinking?.effort });
+      await generator.requester.generate(request, content, control);
+    },
+  }));
+  try {
+    const lifecycle = ctx.get(IAgentLifecycleService);
+    const subagents = ctx.get(ISessionSubagentService);
+    const childProfiles: Array<IAgentProfileService> = [];
+    const runChild = async (id: string) => {
+      const child = lifecycle.get(id) ?? await lifecycle.create({ agentId: id });
+      const handle = lifecycle.handleOf(child.agentId)!;
+      const profile = handle.accessor.get(IAgentProfileService);
+      childProfiles.push(profile);
+      generator.mockNextResponse({ type: 'text', text: 'done' });
+      const loop = handle.accessor.get(IAgentLoopService);
+      const prompt = loop.submit({ message: { role: 'user', content: [{ type: 'text', text: 'synthetic probe' }] }, meta: { origin: { kind: 'user' }, tracked: true } });
+      expect((await loop.promptHandle(prompt.id)!.completion).state).toBe('completed');
+    };
+    const spawnViaPool = async (callerAgentId: string, choice: string) => {
+      const plan = await subagents.planSpawn({ callerAgentId, model: choice });
+      const child = await subagents.spawn({ callerAgentId, plan, prompt: 'synthetic probe' });
+      await runChild(child.agentId);
+      return child.agentId;
+    };
+    const ids = await Promise.all(Object.keys(choiceEntries).map(choice => spawnViaPool('main', choice)));
+    expect(requests.map(r => `${r.model}/${r.effort}`).toSorted()).toEqual(['flash/low', 'flash/high', 'flash/max', 'kimi3/max', 'kimi4/max'].toSorted());
+    config.thinking.forcedEffort = 'max';
+    choiceEntries['t1']!.effort = 'max';
+    ctx.get(IAgentProfileService).update({ modelAlias: 'kimi4', thinkingLevel: 'max' });
+    await lifecycle.remove(lifecycle.get(ids[0]!)!);
+    await runChild(ids[0]!);
+    expect(requests.at(-1)).toEqual({ model: 'flash', effort: 'low' });
+    expect(childProfiles.find(p => p.data().subagentBinding?.choice === 't1')!.data().subagentBinding?.effort).toBe('low');
+    await spawnViaPool('main', 't2');
+    expect(requests.at(-1)).toEqual({ model: 'flash', effort: 'high' });
+    await spawnViaPool(ids[0]!, 'primary');
+    expect(requests.at(-1)).toEqual({ model: 'flash', effort: 'low' });
+    await expect(lifecycle.fork(lifecycle.get(ids[0]!)!, { binding: { thinking: 'max' } })).rejects.toThrow('immutable');
+    await lifecycle.fork(lifecycle.get(ids[0]!)!, { agentId: 'forked-pool-child' });
+    await runChild('forked-pool-child');
+    expect(requests.at(-1)).toEqual({ model: 'flash', effort: 'low' });
+    const restored = lifecycle.handleOf(ids[0]!)!.accessor.get(IAgentProfileService);
+    const count = requests.length;
+    await ctx.get(IConfigService).replace('models', { ...config.models, flash: { ...config.models['flash']!, supportEfforts: ['high', 'max'] } }, ConfigTarget.Memory);
+    expect(() => restored.resolveRequestParams()).toThrow();
+    await ctx.get(IConfigService).replace('models', { kimi3: config.models['kimi3'], kimi4: config.models['kimi4'] }, ConfigTarget.Memory);
+    expect(() => restored.resolveModelContext()).toThrow();
+    expect(requests.length).toBe(count);
+  } finally { await ctx.dispose(); }
+}, 15000);
+
+class PoolTestAppendStore implements IAppendLogStore {
+  declare readonly _serviceBrand: undefined;
+  private records = new Map<string, unknown[]>();
+  readonly onDidWrite = Event.None as IAppendLogStore['onDidWrite'];
+  append<R>(scope: string, key: string, record: R): void { const id = `${scope}/${key}`; this.records.set(id, [...(this.records.get(id) ?? []), structuredClone(record)]); }
+  async *read<R>(scope: string, key: string): AsyncIterable<R> { for (const record of this.records.get(`${scope}/${key}`) ?? []) yield structuredClone(record) as R; }
+  rewrite<R>(scope: string, key: string, records: readonly R[]): Promise<void> { this.records.set(`${scope}/${key}`, structuredClone([...records])); return Promise.resolve(); }
+  flush(): Promise<void> { return Promise.resolve(); }
+  flushLog(): Promise<void> { return Promise.resolve(); }
+  close(): Promise<void> { return Promise.resolve(); }
+  acquire() { return { dispose() {} }; }
+  drainRetirements(): Promise<void> { return Promise.resolve(); }
+  externallyModified(): boolean { return false; }
+  bindWriteGuard() { return { dispose() {} }; }
+}
+
+class PoolTestRuntimeResolver implements IRuntimeResolver {
+  declare readonly _serviceBrand: undefined;
+  private readonly runtime: LocalRuntime;
+  constructor(
+    @IHostEnvironment environment: IHostEnvironment,
+    @IHostFileSystem fs: IHostFileSystem,
+    @IHostProcessService processes: IHostProcessService,
+    @IHostTerminalService terminal: IHostTerminalService,
+  ) { this.runtime = new LocalRuntime('test-workspace', environment, fs, processes, terminal); }
+  inspect(_binding: RuntimeBinding): Runtime { return this.runtime; }
+  acquire(_binding: RuntimeBinding, required: readonly RuntimeCapability[] = []): RuntimeLease {
+    if (required.some(capability => !this.runtime.capabilities.has(capability))) throw new Error('test runtime capability missing');
+    return { runtime: this.runtime, track: resource => resource, dispose: () => {} };
+  }
+}
